NEXTCLOUD_URL=https://nextcloud.m.onsaa.org/ocs/v2.php/apps/notifications/api/v2/notifications
NEXTCLOUD_BASE_URL=https://nextcloud.m.onsaa.org

SIGNAL_URL=http://signal-api:8080/v2/send/
SIGNAL_URL_GET=http://signal-api:8080/v2/receive/

REMINDER_HOURS_BEFORE=24
REMINDER_DAYS_BEFORE=0
REMINDER_DELTAS=[[7,0],[4,0],[2,0],[1,0],[0,0],[-1,0]]

USER_MAP_DC_FILE=/run/secrets/user_map_dc
USER_MAP_SIGNAL_FILE=/run/secrets/user_map_signal

VAULT_ADDR=https://your-vault-host:8200
VAULT_KV_MOUNT=kv
VAULT_USER_MAP_PREFIX=config/user_map_dc

DISCORD_BOT_TOKEN_FILE=/run/secrets/discord_bot_token
NEXTCLOUD_USER_FILE=/run/secrets/nextcloud_user
NEXTCLOUD_PASS_FILE=/run/secrets/nextcloud_pass
SIGNAL_SENDER_FILE=/run/secrets/signal_sender
CALENDAR_NAME_FILE=/run/secrets/calendar_name
CALENDAR_URL_FILE=/run/secrets/calendar_url
DELEGATIONS_JSON_FILE=/run/secrets/delegations_json