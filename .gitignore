# Local environment
.env
.env.*
!.env.example

# Runtime secrets
runtime/secrets/*
!runtime/secrets/.gitkeep
!runtime/secrets/bot/
runtime/secrets/bot/*
!runtime/secrets/bot/.gitkeep
!runtime/secrets/poller/
runtime/secrets/poller/*
!runtime/secrets/poller/.gitkeep
!runtime/secrets/ts-sidecar/
runtime/secrets/ts-sidecar/*
!runtime/secrets/ts-sidecar/.gitkeep
!runtime/secrets/vault-agent/
runtime/secrets/vault-agent/*
!runtime/secrets/vault-agent/.gitkeep

# Vault AppRole material
runtime/vault-auth/*
!runtime/vault-auth/.gitkeep

# Runtime control sentinels
runtime/control/*
!runtime/control/.gitkeep

# Persistent app data and state (recursive: catches any data/<subdir>/)
data/**
!data/app/
!data/app/.gitkeep
!data/tailscale/
!data/tailscale/.gitkeep
# added 2026-07-27: signal-cli state moved under data/ so it is ignored like the rest
!data/signal/
!data/signal/.gitkeep

# Backups
backups/*
!backups/.gitkeep

# Python build artifacts
__pycache__/
*.pyc

# Logs and temp files
*.log
*.tmp
*.bak*
.DS_Store

# OpenTofu / Terraform-compatible state artifacts
.terraform/
.tofu/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# These directories become Docker-owned at runtime. Do not descend into them
# during status or staging, since their live contents are never source files.
runtime/
data/tailscale/
