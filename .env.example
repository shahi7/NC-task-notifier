# ============================================================
# Stack Identity
# ============================================================
HOST_ID=z1
SERVICE_ID=td
STACK_NAME=z1-td

# Repo/runtime location:
# /home/common/stacks/${STACK_NAME}
#
# Container naming standard:
# ${HOST_ID}-${SERVICE_ID}-{component}
#
# Examples:
# z1-nc-dc-task-delegator-bot
# z1-nc-dc-task-delegator-vault-agent
# z1-nc-dc-task-delegator-ts-sidecar

# ============================================================
# App Container
# ============================================================
APP_CONTAINER_PORT=80
APP_UID=1000
APP_GID=1000

# Default private Tailnet route. This is the active Traefik route.
APP_FQDN=nc-dc-task-delegator.m.onsaa.org

# Public route. Only used if the websecure labels are uncommented.
APP_PUBLIC_FQDN=nc-dc-task-delegator.onsaa.org

# ============================================================
# Task Bot Runtime
# ============================================================
# Direct Docker path to Nextcloud. The bot and poller must join
# NEXTCLOUD_INTERNAL_NETWORK, and Nextcloud must trust the `nextcloud` host.
NEXTCLOUD_INTERNAL_NETWORK=nextcloud_stack-internal
NEXTCLOUD_BASE_URL=https://nextcloud.m.onsaa.org

# Signal REST API is local to this stack.
SIGNAL_URL=http://signal-api:8080/v2/send/

# Calendar reminder schedule. REMINDER_DELTAS is a JSON list of [days, hours].
REMINDER_HOURS_BEFORE=24
REMINDER_DAYS_BEFORE=0
REMINDER_DELTAS=[[7,0],[4,0],[2,0],[1,0],[0,0],[-1,0]]

# ============================================================
# Traefik Routing
# ============================================================
TRAEFIK_CERT_RESOLVER=letsencrypt

# Private Tailnet wildcard certificate hint.
TRAEFIK_TLS_DOMAIN_MAIN=m.onsaa.org
TRAEFIK_TLS_DOMAIN_SANS=*.m.onsaa.org

# Gates by tailnet IP, does not authenticate. Same name on p1 and z1.
TAILSECURE_MIDDLEWARES=tailnet-chain@file

# Public wildcard certificate hint. Only used when websecure is enabled.
TRAEFIK_PUBLIC_TLS_DOMAIN_MAIN=onsaa.org
TRAEFIK_PUBLIC_TLS_DOMAIN_SANS=*.onsaa.org

# p1 only. Use public-login-chain for login forms. A typo silently breaks the router.
WEBSECURE_MIDDLEWARES=public-chain@file

# ============================================================
# Tailscale / Headscale
# ============================================================
# Sidecar identity used for private service access and cross-host visibility.
TAILSCALE_VERSION=stable
TS_HOSTNAME=z1-nc-dc-task-delegator
TS_LOGIN_SERVER=https://h.onsaa.org

# Must match the target host's workspace group GID, or containers with
# cap_drop:ALL cannot read their own Vault-rendered secrets.
#   prime1 (p1)    -> 1008
#   zeppelin1 (z1)  -> 1007
# This template defaults HOST_ID=z1 above, so the default here is 1007.
STACK_SECRETS_GID=1007

# Tailscale sidecar argument contract:
# - TS_LOGIN_SERVER owns --login-server.
# - TS_EXTRA_ARGS is for steady-state tailscale up flags only.
# - TS_BOOTSTRAP_EXTRA_ARGS is for rare one-shot extras and must not repeat
#   --login-server, --auth-key, or flags already present in TS_EXTRA_ARGS.
# - Leave both tag inputs blank for the standard recovery path so bootstrap
#   stays untagged and final tags are applied server-side after the node
#   reaches Running.
TS_EXTRA_ARGS=--accept-dns=false
TS_BOOTSTRAP_EXTRA_ARGS=
TS_RESET_ON_REAUTH=1

# Leave blank for the standard recovery path: bootstrap untagged, verify the
# sidecar reached Running, then apply final tags server-side in Headscale.
TS_TAG=
TS_FINAL_TAGS=tag:container,tag:services

# Default exposure is Traefik tailsecure. Set to 1 only if direct Tailscale
# Serve should also be enabled for this service.
TS_SERVE_ENABLED=0

# Compatibility fallback only. Prefer the runtime/control/tailscale-force-reauth
# sentinel over keeping this enabled in .env.
TS_FORCE_REAUTH=0

# ============================================================
# Vault Agent Runtime
# ============================================================
# Vault 2.x exists. This template intentionally defaults to the newest
# current 1.x line so service repos do not jump major versions accidentally.
VAULT_VERSION=1.21.4

# Used inside the vault-agent container.
VAULT_ADDR=https://vault:8200
VAULT_NAMESPACE=
VAULT_CACERT=/vault/tls/ca.crt

# Host path mounted into vault-agent as VAULT_CACERT.
HOST_VAULT_CA_CERT=/home/common/vault/tls/ca.crt

# KV path read by vault/templates/*.ctmpl.
VAULT_KV_PATH=kv/data/nc-dc-task-delegator
APPROLE_MOUNT=approle
VAULT_STATIC_SECRET_RENDER_INTERVAL=5m
VAULT_AGENT_UID=65534
VAULT_AGENT_GID=65534

# ============================================================
# Host-side Vault Setup Helper
# ============================================================
# Used by scripts/setup-service.sh to create/update the Vault policy,
# AppRole, and runtime/vault-auth files. These are not consumed by
# docker compose directly.
CONTROLS_ENV=/home/common/config/controls.env
VAULT_API_ADDR=https://127.0.0.1:8200
VAULT_API_CACERT=/home/common/vault/tls/ca.crt
VAULT_SKIP_VERIFY=false
VAULT_APPROLE_NAME=nc-dc-task-delegator
VAULT_POLICY_NAME=app-nc-dc-task-delegator-read-kv
VAULT_KV_MOUNT=kv
VAULT_KV_VERSION=2
VAULT_APPROLE_TOKEN_TTL=1h
VAULT_APPROLE_TOKEN_MAX_TTL=24h
# Legacy persistent profile until the managed SecretID rotator is deployed.
# Do not set finite values on unattended stacks without a tested atomic
# rotation/revocation controller; Vault Agent must reauthenticate at max TTL.
VAULT_APPROLE_SECRET_ID_TTL=0
VAULT_APPROLE_SECRET_ID_USES=0
VAULT_TOKEN_FILE=

# ============================================================
# Headscale / Tailscale Authkey Minting Helper
# ============================================================
# Optional authkey generation through the local Headscale container.
# These can live in /home/common/config/controls.env instead.
HEADSCALE_CONTAINER=headscale
# Headscale v0.29 expects a numeric user ID; resolve it on the target host.
HEADSCALE_USER=
TS_AUTHKEY_EXPIRATION=24h
TS_AUTHKEY_REUSABLE=true
TS_AUTHKEY_EPHEMERAL=false

# ============================================================
# Optional Service Bootstrap Hooks
# ============================================================
# Services that need first-run app state before the main container can become
# healthy can implement:
#
#   hooks/bootstrap-service-state.sh
#
# CI never provisions Vault or transports a parent token. An administrator
# must provision .env and runtime/vault-auth before enabling deployment.
SETUP_SERVICE=false
BOOTSTRAP_SERVICE_STATE=false
# Headscale retagging is a separate administrator-owned workflow.
RETAG_TAILSCALE=false
HEADSCALE_HOST=prime1
HEADSCALE_REMOTE_USER=gitlab-p1
